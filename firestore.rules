rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /scans/{scanId} {
      allow read: if true;         // demo: anyone can read
      allow write: if false;       // only Cloud Functions (Admin SDK) write
      allow read, write: if request.time < timestamp.date(2025, 10, 16);
    }
  }
}
